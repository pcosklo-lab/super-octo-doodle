ANTHROPIC_API_KEY=your_api_key_here

# Pre-installed Playwright browsers path (set if browsers are not in default location)
# PLAYWRIGHT_BROWSERS_PATH=/opt/pw-browsers

# ── Business Leads Generator ────────────────────────────────────────────────
# Google Places API key (required for leads feature)
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create an API key and enable: Places API
# 3. Restrict the key to Places API for security
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# Hunter.io API key (optional — enables email lookup per business domain)
# Free plan: 25 searches/month  |  https://hunter.io/api
HUNTER_IO_API_KEY=your_hunter_io_api_key_here

# Leads search defaults (can also be passed as CLI args)
# Usage: npm run leads -- "restaurants" "Austin, TX" 50
LEADS_QUERY=local businesses
LEADS_LOCATION=New York, NY
LEADS_COUNT=50
